# Application Ports & Settings
APP_PORT=8080
APP_HOST_PORT=8080
CONTAINER_APP_NAME=api_gateway
LOG_FILE=

# Database Credentials & Settings
DB_USER=gateway_user
DB_PASSWORD=your_secure_db_password
DB_NAME=api_gateway
DB_HOST_PORT=5432
CONTAINER_DB_NAME=gateway_postgres
DB_URL=postgres://${DB_USER}:${DB_PASSWORD}@${CONTAINER_DB_NAME}:${DB_HOST_PORT}/${DB_NAME}?sslmode=disable

# Redis Settings
REDIS_HOST_PORT=6379
CONTAINER_REDIS_NAME=gateway_redis

